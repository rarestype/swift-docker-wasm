#!/usr/bin/env python3
"""
Antigravity Team Hierarchy Manager (`team`)

Manages recursive, multi-tiered agent timelines:
  Teams (Master Architects) -> Feature Czars -> Forked Workers

Persistent state is stored on the host in:
  /swift/conversations/team.json
"""

import sys
import os
import json
import sqlite3
import subprocess
import argparse

REGISTRY_PATH = "/swift/conversations/team.json"

# ANSI Colors
CYAN = "\033[36m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
MAGENTA = "\033[35m"
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"

def is_tty():
    return sys.stdout.isatty()

def c(text, color):
    return f"{color}{text}{RESET}" if is_tty() else text

def get_db_path():
    candidate = "/home/ubuntu/.gemini/antigravity-cli/conversation_summaries.db"
    if os.path.exists(candidate):
        return candidate
    return "/swift/conversations/conversation_summaries.db"

def load_registry():
    if not os.path.exists(REGISTRY_PATH):
        return {"teams": {}}
    try:
        with open(REGISTRY_PATH, "r") as f:
            return json.load(f)
    except Exception as e:
        print(f"Error loading {REGISTRY_PATH}: {e}", file=sys.stderr)
        sys.exit(1)

def save_registry(data):
    tmp_path = REGISTRY_PATH + ".tmp"
    with open(tmp_path, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp_path, REGISTRY_PATH)

def sync_sqlite(conv_id, title=None, parent_id=None, depth=None, project_id=None):
    db_path = get_db_path()
    if not os.path.exists(db_path):
        return
    try:
        conn = sqlite3.connect(db_path)
        cur = conn.cursor()
        updates = []
        params = []
        if title is not None:
            updates.append("title = ?")
            params.append(title)
        if parent_id is not None:
            updates.append("parent_conversation_id = ?")
            params.append(parent_id)
        if depth is not None:
            updates.append("nesting_depth = ?")
            params.append(depth)
        if project_id is not None:
            updates.append("project_id = ?")
            params.append(project_id)
        if updates:
            params.append(conv_id)
            sql = f"UPDATE conversation_summaries SET {', '.join(updates)} WHERE conversation_id = ?;"
            cur.execute(sql, tuple(params))
            conn.commit()
            cur.execute("PRAGMA wal_checkpoint(TRUNCATE);")
        conn.close()
    except Exception as e:
        pass  # non-fatal sync

def render_tree(data):
    teams = data.get("teams", {})
    if not teams:
        print("No teams configured yet. Use 'team new-team <name>' to create one.")
        return

    print(c("\nAntigravity Team Hierarchy", BOLD))
    print(c("==========================", DIM))

    team_keys = sorted(teams.keys())
    for t_idx, t_key in enumerate(team_keys):
        team = teams[t_key]
        arch = team.get("architect", {})
        arch_title = arch.get("title", "Master Architect")
        arch_id = arch.get("id", "no-id")[:8]
        is_last_team = (t_idx == len(team_keys) - 1)

        print(f"\n{c('●', CYAN)} {c(t_key, BOLD)} ({team.get('title', 'Team')})")
        print(f"  {c('└── [Architect]', YELLOW)} {arch_title} {c('(' + arch_id + ')', DIM)}")

        czars = team.get("czars", {})
        czar_keys = sorted(czars.keys())
        for c_idx, c_key in enumerate(czar_keys):
            czar = czars[c_key]
            c_title = czar.get("title", c_key)
            c_id = czar.get("id", "no-id")[:8]
            c_status = czar.get("status", "active")
            is_last_czar = (c_idx == len(czar_keys) - 1)

            status_badge = c("[active]", GREEN) if c_status == "active" else c("[completed]", DIM)
            branch_info = f" {c('(' + czar.get('branch') + ')', DIM)}" if czar.get("branch") else ""
            czar_prefix = "  └── " if is_last_czar else "  ├── "

            print(f"{czar_prefix}{c('czar/' + c_key, BOLD)} {status_badge}{branch_info} {c_title} {c('(' + c_id + ')', DIM)}")

            workers = czar.get("workers", {})
            w_keys = sorted(workers.keys())
            for w_idx, w_key in enumerate(w_keys):
                worker = workers[w_key]
                w_title = worker.get("title", w_key)
                w_id = worker.get("id", "no-id")[:8]
                w_status = worker.get("status", "active")
                is_last_worker = (w_idx == len(w_keys) - 1)

                w_badge = c("[active]", GREEN) if w_status == "active" else c("[completed]", DIM)
                sub_indent = "      " if is_last_czar else "  │   "
                worker_prefix = f"{sub_indent}└── " if is_last_worker else f"{sub_indent}├── "

                print(f"{worker_prefix}{c('worker/' + w_key, MAGENTA)} {w_badge} {w_title} {c('(' + w_id + ')', DIM)}")
    print()

def resolve_path(data, path_parts):
    parts = []
    for p in path_parts:
        parts.extend([x for x in p.split("/") if x])

    teams = data.get("teams", {})
    if not parts:
        return None, None, "empty path"

    # 1. Exact match starting from Team
    team_name = parts[0]
    if team_name in teams:
        team = teams[team_name]
        if len(parts) == 1:
            arch = team.get("architect")
            if not arch or "id" not in arch:
                return None, None, f"Team '{team_name}' has no Master Architect configured."
            return arch["id"], f"{team_name} (Architect)", None

        czar_name = parts[1]
        czars = team.get("czars", {})
        if czar_name in czars:
            czar = czars[czar_name]
            if len(parts) == 2:
                return czar.get("id"), f"{team_name}/{czar_name} (Czar)", None

            worker_name = parts[2]
            workers = czar.get("workers", {})
            if worker_name in workers:
                worker = workers[worker_name]
                return worker.get("id"), f"{team_name}/{czar_name}/{worker_name} (Worker)", None
            else:
                return None, None, f"Worker '{worker_name}' not found under Czar '{czar_name}'."
        else:
            return None, None, f"Czar '{czar_name}' not found under Team '{team_name}'."

    # 2. Check if parts match czar/worker across teams
    if len(parts) == 2:
        c_query, w_query = parts[0], parts[1]
        matches = []
        for t_name, team in teams.items():
            czars = team.get("czars", {})
            if c_query in czars:
                czar = czars[c_query]
                workers = czar.get("workers", {})
                if w_query in workers:
                    matches.append((workers[w_query].get("id"), f"{t_name}/{c_query}/{w_query} (Worker)"))
        if len(matches) == 1:
            return matches[0][0], matches[0][1], None
        elif len(matches) > 1:
            match_desc = ", ".join(m[1] for m in matches)
            return None, None, f"Ambiguous path '{'/'.join(parts)}'. Matches: {match_desc}."

    # 3. Fuzzy fallback: match unique single token (Team, Czar, or Worker) across all teams
    if len(parts) == 1:
        query = parts[0]
        matches = []
        for t_name, team in teams.items():
            if query == t_name:
                matches.append((team.get("architect", {}).get("id"), f"{t_name} (Architect)"))
            for c_name, czar in team.get("czars", {}).items():
                if query == c_name:
                    matches.append((czar.get("id"), f"{t_name}/{c_name} (Czar)"))
                for w_name, worker in czar.get("workers", {}).items():
                    if query == w_name:
                        matches.append((worker.get("id"), f"{t_name}/{c_name}/{w_name} (Worker)"))

        if len(matches) == 1:
            return matches[0][0], matches[0][1], None
        elif len(matches) > 1:
            match_desc = ", ".join(m[1] for m in matches)
            return None, None, f"Ambiguous name '{query}'. Matches: {match_desc}. Please specify the full path."

    return None, None, f"Path '{'/'.join(parts)}' not found in team registry."

def launch_conversation(conv_id, label, extra_args=None):
    if not conv_id:
        print("Error: No conversation ID provided.", file=sys.stderr)
        sys.exit(1)
    print(c(f"Entering {label} [{conv_id[:8]}]...", GREEN))
    sys.stdout.flush()
    cmd = ["agy", "--conversation", conv_id]
    if extra_args:
        cmd.extend(extra_args)
    os.execvp("agy", cmd)

def spawn_agy_conversation(project_name, seed_prompt):
    cmd = ["agy", "--project", project_name, "--output-format", "json", "-p", seed_prompt]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=True)
        out = json.loads(res.stdout)
        return out.get("conversation_id")
    except subprocess.CalledProcessError as e:
        print(f"Error starting new conversation via agy: {e.stderr}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error parsing agy response: {e}", file=sys.stderr)
        sys.exit(1)

def cmd_fork(args):
    data = load_registry()
    teams = data.get("teams", {})
    parts = [x for x in args.target.split("/") if x]

    if len(parts) == 1:
        team_name = parts[0]
        if team_name not in teams:
            # Check if target is a Czar instead of team
            matches = []
            for t_name, t_val in teams.items():
                if team_name in t_val.get("czars", {}):
                    matches.append((t_name, team_name))
            if len(matches) == 1:
                parts = [matches[0][0], matches[0][1]]
            elif len(matches) > 1:
                print(f"Error: Ambiguous Czar '{team_name}'. Specify <team>/<czar>.", file=sys.stderr)
                sys.exit(1)
            else:
                print(f"Error: Team or Czar '{team_name}' does not exist.", file=sys.stderr)
                sys.exit(1)

    if len(parts) == 1:
        team_name = parts[0]
        team = teams[team_name]
        czar_name = args.name
        title = args.title or f"{czar_name} Sprint"
        prompt = args.prompt or f"You are the Feature Czar for '{czar_name}' under team '{team_name}'. Goal: {title}"

        print(c(f"Forking Feature Czar '{czar_name}' under team '{team_name}'...", BOLD))
        conv_id = spawn_agy_conversation(team_name, prompt)
        arch_id = team.get("architect", {}).get("id")

        team.setdefault("czars", {})[czar_name] = {
            "id": conv_id,
            "title": title,
            "status": "active",
            "workers": {}
        }
        save_registry(data)
        sync_sqlite(conv_id, title=f"[{team_name} > {czar_name}] {title}", parent_id=arch_id, depth=1, project_id=team_name)
        if not args.no_launch:
            launch_conversation(conv_id, f"{team_name}/{czar_name} (Czar)")
        else:
            print(c(f"✓ Created Czar '{team_name}/{czar_name}' [{conv_id[:8]}].", GREEN))

    elif len(parts) == 2:
        team_name, czar_name = parts[0], parts[1]
        if team_name not in teams or czar_name not in teams[team_name].get("czars", {}):
            print(f"Error: Czar '{czar_name}' not found under team '{team_name}'.", file=sys.stderr)
            sys.exit(1)
        czar = teams[team_name]["czars"][czar_name]
        worker_name = args.name
        title = args.title or f"{worker_name} Task"
        prompt = args.prompt or f"You are a specialized worker '{worker_name}' for Czar '{czar_name}'. Task: {title}"

        print(c(f"Forking Worker '{worker_name}' under Czar '{czar_name}'...", BOLD))
        conv_id = spawn_agy_conversation(team_name, prompt)
        czar_id = czar.get("id")

        czar.setdefault("workers", {})[worker_name] = {
            "id": conv_id,
            "title": title,
            "status": "active"
        }
        save_registry(data)
        sync_sqlite(conv_id, title=f"[{team_name} > {czar_name} > {worker_name}] {title}", parent_id=czar_id, depth=2, project_id=team_name)
        if not args.no_launch:
            launch_conversation(conv_id, f"{team_name}/{czar_name}/{worker_name} (Worker)")
        else:
            print(c(f"✓ Created Worker '{team_name}/{czar_name}/{worker_name}' [{conv_id[:8]}].", GREEN))
    else:
        print("Error: Target must be either a Team (to fork a Czar) or a Czar (to fork a Worker).", file=sys.stderr)
        sys.exit(1)

def cmd_done(args):
    data = load_registry()
    parts = [x for x in args.target.split("/") if x]
    teams = data.get("teams", {})

    if len(parts) == 1:
        # Check if single part is unique czar or worker
        c_matches = []
        for t_name, team in teams.items():
            if parts[0] in team.get("czars", {}):
                c_matches.append((t_name, parts[0]))
        if len(c_matches) == 1:
            t_name, c_name = c_matches[0]
            teams[t_name]["czars"][c_name]["status"] = "completed"
            save_registry(data)
            print(c(f"✓ Marked Czar '{t_name}/{c_name}' as completed.", GREEN))
            return

    if len(parts) == 2:
        # team/czar or czar/worker
        team_name, czar_name = parts[0], parts[1]
        if team_name in teams and czar_name in teams[team_name].get("czars", {}):
            teams[team_name]["czars"][czar_name]["status"] = "completed"
            save_registry(data)
            print(c(f"✓ Marked Czar '{team_name}/{czar_name}' as completed.", GREEN))
            return
        # check czar/worker
        for t_name, team in teams.items():
            if team_name in team.get("czars", {}):
                czar = team["czars"][team_name]
                if czar_name in czar.get("workers", {}):
                    czar["workers"][czar_name]["status"] = "completed"
                    save_registry(data)
                    print(c(f"✓ Marked Worker '{t_name}/{team_name}/{czar_name}' as completed.", GREEN))
                    return

    if len(parts) == 3:
        team_name, czar_name, worker_name = parts[0], parts[1], parts[2]
        czar = teams.get(team_name, {}).get("czars", {}).get(czar_name, {})
        if worker_name in czar.get("workers", {}):
            czar["workers"][worker_name]["status"] = "completed"
            save_registry(data)
            print(c(f"✓ Marked Worker '{team_name}/{czar_name}/{worker_name}' as completed.", GREEN))
            return

    print(f"Error: Target '{args.target}' not found.", file=sys.stderr)
    sys.exit(1)

def cmd_reopen(args):
    data = load_registry()
    parts = [x for x in args.target.split("/") if x]
    teams = data.get("teams", {})

    if len(parts) == 1:
        c_matches = []
        for t_name, team in teams.items():
            if parts[0] in team.get("czars", {}):
                c_matches.append((t_name, parts[0]))
        if len(c_matches) == 1:
            t_name, c_name = c_matches[0]
            teams[t_name]["czars"][c_name]["status"] = "active"
            save_registry(data)
            print(c(f"✓ Re-opened Czar '{t_name}/{c_name}' as active.", GREEN))
            return

    if len(parts) == 2:
        team_name, czar_name = parts[0], parts[1]
        if team_name in teams and czar_name in teams[team_name].get("czars", {}):
            teams[team_name]["czars"][czar_name]["status"] = "active"
            save_registry(data)
            print(c(f"✓ Re-opened Czar '{team_name}/{czar_name}' as active.", GREEN))
            return
        for t_name, team in teams.items():
            if team_name in team.get("czars", {}):
                czar = team["czars"][team_name]
                if czar_name in czar.get("workers", {}):
                    czar["workers"][czar_name]["status"] = "active"
                    save_registry(data)
                    print(c(f"✓ Re-opened Worker '{t_name}/{team_name}/{czar_name}' as active.", GREEN))
                    return

    if len(parts) == 3:
        team_name, czar_name, worker_name = parts[0], parts[1], parts[2]
        czar = teams.get(team_name, {}).get("czars", {}).get(czar_name, {})
        if worker_name in czar.get("workers", {}):
            czar["workers"][worker_name]["status"] = "active"
            save_registry(data)
            print(c(f"✓ Re-opened Worker '{team_name}/{czar_name}/{worker_name}' as active.", GREEN))
            return

    print(f"Error: Target '{args.target}' not found.", file=sys.stderr)
    sys.exit(1)

def cmd_new_team(args):
    data = load_registry()
    team_name = args.team_name
    if team_name in data.get("teams", {}):
        print(f"Error: Team '{team_name}' already exists.", file=sys.stderr)
        sys.exit(1)

    title = args.title or f"{team_name} Team"
    prompt = args.prompt or f"You are the Master Architect for team '{team_name}' ({title}). You oversee architecture and system design."

    print(c(f"Initializing new team '{team_name}' and Master Architect...", BOLD))
    conv_id = spawn_agy_conversation(team_name, prompt)

    data.setdefault("teams", {})[team_name] = {
        "title": title,
        "architect": {
            "id": conv_id,
            "title": f"Master Architect ({team_name})"
        },
        "czars": {}
    }
    save_registry(data)
    sync_sqlite(conv_id, title=f"[{team_name} Architect] {title}", depth=0, project_id=team_name)
    if not args.no_launch:
        launch_conversation(conv_id, f"{team_name} (Master Architect)")
    else:
        print(c(f"✓ Created Team '{team_name}' [{conv_id[:8]}].", GREEN))

def cmd_send(args):
    data = load_registry()
    conv_id, label, err = resolve_path(data, [args.target])
    if err:
        print(f"Error: {err}", file=sys.stderr)
        sys.exit(1)
    prompt = " ".join(args.prompt) if isinstance(args.prompt, list) else args.prompt
    if not prompt:
        print("Error: No prompt specified.", file=sys.stderr)
        sys.exit(1)
    print(c(f"Sending prompt to {label} [{conv_id[:8]}]...", BOLD))
    cmd = ["agy", "--conversation", conv_id, "-p", prompt]
    try:
        subprocess.run(cmd, check=True)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)

def cmd_id(args):
    data = load_registry()
    conv_id, _, err = resolve_path(data, [args.target])
    if err:
        print(f"Error: {err}", file=sys.stderr)
        sys.exit(1)
    print(conv_id)

def cmd_branch(args):
    data = load_registry()
    parts = [x for x in args.target.split("/") if x]
    teams = data.get("teams", {})
    if len(parts) == 1:
        c_query = parts[0]
        matches = []
        for t_name, team in teams.items():
            if c_query in team.get("czars", {}):
                matches.append((t_name, c_query))
        if len(matches) == 1:
            t_name, c_name = matches[0]
            teams[t_name]["czars"][c_name]["branch"] = args.branch
            save_registry(data)
            print(c(f"✓ Set branch for Czar '{t_name}/{c_name}' to '{args.branch}'.", GREEN))
            return
        elif len(matches) > 1:
            print(f"Error: Ambiguous Czar '{c_query}'. Please use <team>/<czar>.", file=sys.stderr)
            sys.exit(1)
    elif len(parts) == 2:
        t_name, c_name = parts[0], parts[1]
        if t_name in teams and c_name in teams[t_name].get("czars", {}):
            teams[t_name]["czars"][c_name]["branch"] = args.branch
            save_registry(data)
            print(c(f"✓ Set branch for Czar '{t_name}/{c_name}' to '{args.branch}'.", GREEN))
            return
    print(f"Error: Czar '{args.target}' not found.", file=sys.stderr)
    sys.exit(1)

def _confirm_and_delete(args, desc, conv_ids, delete_fn, data):
    count_str = f" ({len(conv_ids)} conversation{'s' if len(conv_ids) != 1 else ''})" if conv_ids else ""
    purge_str = " AND purge conversation database files from disk" if args.purge else ""

    if not args.force:
        if not sys.stdin.isatty():
            print(f"Error: Deleting {desc} in non-interactive mode requires -f / --force.", file=sys.stderr)
            sys.exit(1)
        try:
            resp = input(f"Are you sure you want to delete {desc}{count_str}{purge_str}? [y/N]: ")
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            sys.exit(1)
        if resp.strip().lower() not in ["y", "yes"]:
            print("Aborted.")
            return

    delete_fn()
    save_registry(data)
    print(c(f"✓ Removed {desc} from team registry.", GREEN))

    if args.purge and conv_ids:
        # 1. Purge from SQLite
        db_path = get_db_path()
        if os.path.exists(db_path):
            try:
                conn = sqlite3.connect(db_path)
                cur = conn.cursor()
                placeholders = ",".join("?" for _ in conv_ids)
                cur.execute(f"DELETE FROM conversation_summaries WHERE conversation_id IN ({placeholders});", tuple(conv_ids))
                conn.commit()
                cur.execute("PRAGMA wal_checkpoint(TRUNCATE);")
                conn.close()
            except Exception as e:
                print(f"Warning: Failed to purge from SQLite summaries: {e}", file=sys.stderr)

        # 2. Purge from disk
        purged_files = 0
        for cid in conv_ids:
            for ext in [".db", ".pb", ".db-shm", ".db-wal"]:
                fpath = f"/swift/conversations/{cid}{ext}"
                if os.path.exists(fpath):
                    try:
                        os.remove(fpath)
                        purged_files += 1
                    except OSError:
                        pass
        print(c(f"✓ Purged {purged_files} conversation files for {len(conv_ids)} timeline(s) from disk.", GREEN))

def cmd_delete(args):
    data = load_registry()
    parts = [x for x in args.target.split("/") if x]
    teams = data.get("teams", {})

    conv_ids = []

    # Case 1: Single token (Team name or unique Czar)
    if len(parts) == 1:
        name = parts[0]
        if name in teams:
            team = teams[name]
            desc = f"Team '{name}'"
            if "architect" in team and "id" in team["architect"]:
                conv_ids.append(team["architect"]["id"])
            for czar in team.get("czars", {}).values():
                if "id" in czar:
                    conv_ids.append(czar["id"])
                for worker in czar.get("workers", {}).values():
                    if "id" in worker:
                        conv_ids.append(worker["id"])

            _confirm_and_delete(args, desc, conv_ids, lambda: teams.pop(name), data)
            return

        c_matches = []
        for t_name, team in teams.items():
            if name in team.get("czars", {}):
                c_matches.append((t_name, name))
        if len(c_matches) == 1:
            t_name, c_name = c_matches[0]
            czar = teams[t_name]["czars"][c_name]
            desc = f"Czar '{t_name}/{c_name}'"
            if "id" in czar:
                conv_ids.append(czar["id"])
            for worker in czar.get("workers", {}).values():
                if "id" in worker:
                    conv_ids.append(worker["id"])

            _confirm_and_delete(args, desc, conv_ids, lambda: teams[t_name]["czars"].pop(c_name), data)
            return
        elif len(c_matches) > 1:
            print(f"Error: Ambiguous Czar '{name}'. Specify <team>/<czar>.", file=sys.stderr)
            sys.exit(1)

    # Case 2: team/czar or czar/worker
    if len(parts) == 2:
        t_name, c_name = parts[0], parts[1]
        if t_name in teams and c_name in teams[t_name].get("czars", {}):
            czar = teams[t_name]["czars"][c_name]
            desc = f"Czar '{t_name}/{c_name}'"
            if "id" in czar:
                conv_ids.append(czar["id"])
            for worker in czar.get("workers", {}).values():
                if "id" in worker:
                    conv_ids.append(worker["id"])

            _confirm_and_delete(args, desc, conv_ids, lambda: teams[t_name]["czars"].pop(c_name), data)
            return

        for team_key, team in teams.items():
            if t_name in team.get("czars", {}):
                czar = team["czars"][t_name]
                if c_name in czar.get("workers", {}):
                    worker = czar["workers"][c_name]
                    desc = f"Worker '{team_key}/{t_name}/{c_name}'"
                    if "id" in worker:
                        conv_ids.append(worker["id"])
                    _confirm_and_delete(args, desc, conv_ids, lambda: czar["workers"].pop(c_name), data)
                    return

    # Case 3: team/czar/worker
    if len(parts) == 3:
        t_name, c_name, w_name = parts[0], parts[1], parts[2]
        czar = teams.get(t_name, {}).get("czars", {}).get(c_name, {})
        if w_name in czar.get("workers", {}):
            worker = czar["workers"][w_name]
            desc = f"Worker '{t_name}/{c_name}/{w_name}'"
            if "id" in worker:
                conv_ids.append(worker["id"])
            _confirm_and_delete(args, desc, conv_ids, lambda: czar["workers"].pop(w_name), data)
            return

    print(f"Error: Target '{args.target}' not found.", file=sys.stderr)
    sys.exit(1)

def main():
    if len(sys.argv) == 1:
        render_tree(load_registry())
        return

    first_arg = sys.argv[1]

    if first_arg in ["list", "tree", "ls"]:
        render_tree(load_registry())
        return

    if first_arg == "fork":
        parser = argparse.ArgumentParser(prog="team fork", description="Fork a Czar (from Team) or Worker (from Czar)")
        parser.add_argument("target", help="Parent path (e.g. 'y2k' to fork a Czar, or 'y2k/monetary-base' to fork a Worker)")
        parser.add_argument("name", help="Identifier for the new child node")
        parser.add_argument("title", nargs="?", default="", help="Descriptive title")
        parser.add_argument("--prompt", "-p", default="", help="Seed prompt for the new conversation")
        parser.add_argument("--no-launch", action="store_true", help="Do not immediately launch interactive session")
        args = parser.parse_args(sys.argv[2:])
        cmd_fork(args)
        return

    if first_arg in ["done", "complete"]:
        parser = argparse.ArgumentParser(prog="team done", description="Mark a Czar or Worker as completed")
        parser.add_argument("target", help="Path to mark as completed")
        args = parser.parse_args(sys.argv[2:])
        cmd_done(args)
        return

    if first_arg in ["reopen", "activate"]:
        parser = argparse.ArgumentParser(prog="team reopen", description="Reopen a completed Czar or Worker")
        parser.add_argument("target", help="Path to reopen")
        args = parser.parse_args(sys.argv[2:])
        cmd_reopen(args)
        return

    if first_arg == "new-team":
        parser = argparse.ArgumentParser(prog="team new-team", description="Create a new team with a Master Architect")
        parser.add_argument("team_name", help="Identifier for the new team")
        parser.add_argument("title", nargs="?", default="", help="Display title for the team")
        parser.add_argument("--prompt", "-p", default="", help="Initial architect prompt")
        parser.add_argument("--no-launch", action="store_true", help="Do not immediately launch interactive session")
        args = parser.parse_args(sys.argv[2:])
        cmd_new_team(args)
        return

    if first_arg in ["id", "which"]:
        parser = argparse.ArgumentParser(prog="team id", description="Print raw conversation UUID for a path")
        parser.add_argument("target", help="Path to node (e.g. 'y2k', 'monetary-base', 'monetary-base/stylist')")
        args = parser.parse_args(sys.argv[2:])
        cmd_id(args)
        return

    if first_arg == "send":
        parser = argparse.ArgumentParser(prog="team send", description="Send a prompt non-interactively to a timeline")
        parser.add_argument("target", help="Path to node")
        parser.add_argument("prompt", nargs="+", help="Message to send")
        args = parser.parse_args(sys.argv[2:])
        cmd_send(args)
        return

    if first_arg == "branch":
        parser = argparse.ArgumentParser(prog="team branch", description="Set or update git branch for a Czar")
        parser.add_argument("target", help="Path to Czar (e.g. 'y2k/monetary-base' or 'monetary-base')")
        parser.add_argument("branch", help="Git branch name")
        args = parser.parse_args(sys.argv[2:])
        cmd_branch(args)
        return

    if first_arg in ["delete", "rm", "remove"]:
        parser = argparse.ArgumentParser(prog="team delete", description="Delete a Team, Czar, or Worker")
        parser.add_argument("target", help="Path to node (e.g. 'style-audit', 'y2k/etf-trading', 'monetary-base/stylist')")
        parser.add_argument("-f", "--force", action="store_true", help="Do not prompt for confirmation")
        parser.add_argument("--purge", action="store_true", help="Also purge underlying conversation database files from disk")
        args = parser.parse_args(sys.argv[2:])
        cmd_delete(args)
        return

    if first_arg in ["help", "-h", "--help"]:
        print(c("Antigravity Team Hierarchy Manager (`team`)", BOLD))
        print("\n" + c("Usage:", BOLD))
        print("  team                                  Display the team tree")
        print("  team <path>                           Resume interactive timeline (e.g. 'team y2k', 'team monetary-base', 'team monetary-base/stylist')")
        print("  team <path> -i \"<prompt>\"             Resume interactive timeline with initial prompt")
        print("  team <path> -p \"<prompt>\"             Send prompt non-interactively and print response")
        print("  team fork <parent> <name> [title]     Fork a Czar (from Team) or Worker (from Czar)")
        print("  team send <path> <message...>         Send a prompt non-interactively to a timeline")
        print("  team id <path>                        Print raw conversation UUID")
        print("  team branch <czar> <branch>           Associate a git branch with a Czar")
        print("  team done <path>                      Mark a Czar or Worker as completed")
        print("  team reopen <path>                    Reopen an archived Czar or Worker")
        print("  team delete <path> [-f] [--purge]     Delete a Team, Czar, or Worker (--purge removes DB files)")
        print("  team new-team <name> [title]          Create a new Team with a Master Architect")
        return

    # Check if extra flags follow target: e.g. `team monetary-base -p "hello"` or `team monetary-base -i "hello"`
    target = sys.argv[1]
    extra_args = sys.argv[2:]

    data = load_registry()
    conv_id, label, err = resolve_path(data, [target])
    if err:
        print(f"Error: {err}", file=sys.stderr)
        sys.exit(1)

    if extra_args and extra_args[0] in ["-p", "--print"]:
        prompt = " ".join(extra_args[1:])
        cmd = ["agy", "--conversation", conv_id, "-p", prompt]
        try:
            subprocess.run(cmd, check=True)
        except subprocess.CalledProcessError as e:
            sys.exit(e.returncode)
        return

    launch_conversation(conv_id, label, extra_args)

if __name__ == "__main__":
    main()
