{
    "allowNonWorkspaceAccess": true,
    "permissions": {
        "allow": [
            "command(*)",
            "read_url(github.com)",
            "read_url(raw.githubusercontent.com)"
        ],
        "ask": [
            "command(sudo *)",
            "command(git push *)",
            "command(git reset --hard *)"
        ]
    },
    "statusLine": {
        "type": "",
        "command": "",
        "enabled": true
    }
}
